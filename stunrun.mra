<misterromdescription>
    <name>S.T.U.N. Runner</name>
    <setname>stunrun</setname>
    <year>1989</year>
    <manufacturer>Atari Games</manufacturer>
    <category>Arcade</category>
    <rbf>stunrun</rbf>

    <!-- Image layout (see docs/hardware.md section 8):

           0x000000  786432  68010 program, big-endian words (even byte .200x, odd byte .210x)
           0x0C0000  393216  ADSP-2100 serial "SIM" data, little-endian words (low byte .xxh, high byte .xxk)
           0x120000  262144  OKI6295 ADPCM samples
           0x160000   65536  JSA II 6502 program
           0x170000    2048  200E timekeeper NVRAM factory contents
           0x170800    2048  210E EEPROM factory contents
           0x171000          total
    -->
    <rom index="0" zip="stunrun.zip" md5="8d6ae2b1177b78d2fdcda8956d492f72">

        <!-- 68010 program: interleave pairs, even byte from the 200x socket -->
        <interleave output="16">
            <part name="136070-2102.200r" crc="e0ed54d8" map="01"/>
            <part name="136070-2101.210r" crc="3008bcf8" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="136070-6104.200s" crc="f469f91c" map="01"/>
            <part name="136070-6103.210s" crc="096aad68" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="136070-6106.200t" crc="b445bae5" map="01"/>
            <part name="136070-6105.210t" crc="42736c52" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="136070-2108.200u" crc="0ce849aa" map="01"/>
            <part name="136070-2107.210u" crc="19bc7495" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="136070-2110.200v" crc="4f6d22c5" map="01"/>
            <part name="136070-2109.210v" crc="ac6d4d4a" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="136070-2112.200w" crc="3f896aaf" map="01"/>
            <part name="136070-2111.210w" crc="47f010ad" map="10"/>
        </interleave>

        <!-- ADSP SIM data: 16-bit words stored big-endian like the 68k program (h socket byte at the even address = high byte, k at the odd = low); the core byte-swaps on fetch -->
        <interleave output="16">
            <part name="136070-2121.90h" crc="0ebf8e58" map="01"/>
            <part name="136070-2118.90k" crc="fb98abaf" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="136070-2122.10h" crc="bd5380bd" map="01"/>
            <part name="136070-2119.10k" crc="bde8bd31" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="136070-2120.9h" crc="55a30976" map="01"/>
            <part name="136070-2117.9k" crc="d4a9696d" map="10"/>
        </interleave>

        <!-- OKI6295 ADPCM -->
        <part name="136070-2124.1fh" crc="4dc14fe8"/>
        <part name="136070-2125.1ef" crc="cbdabbcc"/>
        <part name="136070-2126.1de" crc="b973d9d1"/>
        <part name="136070-2127.1cd" crc="3e419f4e"/>

        <!-- JSA II 6502 program -->
        <part name="136070-2123.10c" crc="121ab09a"/>

        <!-- NVRAM factory contents -->
        <part name="stunrun.200e" crc="f1e8ba9e"/>
        <part name="stunrun.210e" crc="f1e8ba9e"/>
    </rom>
</misterromdescription>
